# ##############################################################################
# Node.js Gitignore Template
# ##############################################################################

# Dependencies
node_modules/
jspm_packages/
bower_components/
.pnpm-store/

# Development / Local Environment Files
# NEVER commit your production secrets or actual .env files to source control!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

!.env.example

# Logs and Diagnostics
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock

# Build Outputs and Runtimes
dist/
build/
out/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/

# Testing and Coverage
coverage/
*.lcov
.nyc_output
test-output/

# IDEs and Text Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating System Files
.DS_Store
Thumbs.db
